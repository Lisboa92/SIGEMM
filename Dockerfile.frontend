# ─────────────────────────────────────────────────────────────────────────────
# CAMADA 1 — Frontend (React + Vite + Tailwind) servido por Nginx
# Build em duas fases (multi-stage) para gerar uma imagem final pequena.
# ─────────────────────────────────────────────────────────────────────────────

# Fase 1: compilação da SPA com Node
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json bun.lock* ./
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build

# Fase 2: imagem final servida por Nginx
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]